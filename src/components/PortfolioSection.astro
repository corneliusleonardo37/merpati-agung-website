---
import { portfolioItems } from '../data/portfolio';
---

<section id="produk" class="bg-stone-50 px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
      Produk
    </p>

    <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
      Contoh kebutuhan botol plastik HDPE yang dapat kami bantu produksi.
    </h2>

    <p class="mt-5 max-w-2xl leading-8 text-stone-600">
      Merpati Agung Plastik melayani kebutuhan kemasan botol HDPE untuk berbagai jenis
      produk. Spesifikasi seperti ukuran, warna, tutup, dan jumlah produksi dapat
      dikonsultasikan terlebih dahulu.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {portfolioItems.slice(0, 3).map((item) => (
        <div class="overflow-hidden rounded-3xl border border-stone-200 bg-white">
          {item.image ? (
            <img
              src={item.image}
              alt={`${item.title} - ${item.category} dari Merpati Agung Plastik`}
              class="h-48 w-full object-cover"
            />
          ) : (
            <div class="flex h-48 items-center justify-center bg-gradient-to-br from-emerald-50 to-stone-200">
              <span class="text-xs font-semibold uppercase tracking-[0.25em] text-stone-500">
                Botol HDPE
              </span>
            </div>
          )}

          <div class="p-6">
            <p class="text-sm font-semibold text-emerald-700">
              {item.category} · {item.location}
            </p>

            <h3 class="mt-2 text-xl font-semibold">
              {item.title}
            </h3>

            <p class="mt-3 text-sm leading-7 text-stone-600">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <a
      href="/portfolio"
      class="mt-8 inline-flex rounded-full border border-stone-300 px-6 py-3 text-sm font-semibold text-stone-800 transition hover:bg-white"
    >
      Lihat Semua Produk
    </a>
  </div>
</section>