---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { services } from '../data/services';
---

<Layout
  title="Produk Botol Plastik HDPE | Merpati Agung Plastik"
  description="Merpati Agung Plastik memproduksi botol plastik HDPE untuk kebutuhan cleaning product, chemical tertentu, kosmetik, personal care, brand, distributor, dan industri."
  canonicalPath="/layanan"
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
        Produk & Layanan
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Produksi botol plastik HDPE untuk kebutuhan bisnis dan industri.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Merpati Agung Plastik melayani kebutuhan botol HDPE untuk brand, distributor,
        toko packaging, pabrik, dan industri yang membutuhkan kemasan plastik secara rutin.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-2">
          {services.map((service) => (
            <div class="rounded-3xl border border-stone-200 bg-stone-50 p-8">
              <h2 class="text-2xl font-bold">{service.title}</h2>
              <p class="mt-4 leading-8 text-stone-600">
                {service.description}
              </p>

              <div class="mt-6 rounded-2xl bg-white p-5 text-sm leading-7 text-stone-600">
                Spesifikasi dapat didiskusikan berdasarkan ukuran botol, warna, jenis tutup,
                bahan, jumlah produksi, dan kebutuhan pengiriman.
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
          Catatan Produksi
        </p>

        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
          Setiap kebutuhan botol sebaiknya dikonfirmasi sebelum produksi.
        </h2>

        <p class="mt-5 max-w-3xl leading-8 text-stone-600">
          Jenis produk, ukuran kemasan, warna botol, model tutup, dan jumlah order akan
          memengaruhi pilihan botol serta penawaran harga. Karena itu, konsultasi awal penting
          supaya spesifikasi lebih jelas dan tidak asal cocok-cocokan.
        </p>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>