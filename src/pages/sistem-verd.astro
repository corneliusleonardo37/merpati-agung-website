---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { systemValues } from '../data/system';
import { processSteps } from '../data/process';
---

<Layout
  title="Proses Order Botol Plastik HDPE | Merpati Agung Plastik"
  description="Pelajari proses pemesanan botol plastik HDPE di Merpati Agung Plastik, mulai dari konsultasi kebutuhan, cek model, sample, penawaran, produksi, hingga pengiriman."
  canonicalPath="/sistem-verd"
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
        Proses Order
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Proses pemesanan botol plastik HDPE yang jelas dari awal sampai pengiriman.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Merpati Agung Plastik membantu buyer menentukan kebutuhan botol berdasarkan jenis
        produk, ukuran, warna, jenis tutup, jumlah order, dan kebutuhan pengiriman.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-3">
          {systemValues.map((item) => (
            <div class="rounded-3xl border border-stone-200 bg-stone-50 p-8">
              <h2 class="text-2xl font-bold">{item.title}</h2>
              <p class="mt-4 leading-8 text-stone-600">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
          Alur Pemesanan
        </p>

        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
          Dari konsultasi spesifikasi sampai botol siap dikirim.
        </h2>

        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {processSteps.map((step) => (
            <div class="rounded-3xl border border-stone-200 bg-white p-8">
              <p class="text-sm font-semibold text-emerald-700">{step.number}</p>
              <h3 class="mt-3 text-xl font-semibold">{step.title}</h3>
              <p class="mt-4 leading-8 text-stone-600">
                {step.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-3xl bg-emerald-950 p-8 text-white md:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-200">
            Catatan Penting
          </p>

          <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
            Spesifikasi botol perlu jelas sebelum produksi.
          </h2>

          <p class="mt-5 max-w-3xl leading-8 text-emerald-50/80">
            Jenis produk, kapasitas botol, warna, jenis tutup, dan jumlah order akan
            memengaruhi pilihan kemasan serta harga produksi. Karena itu, diskusi awal
            membantu proses order berjalan lebih rapi dan mengurangi risiko salah spesifikasi.
          </p>
        </div>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>