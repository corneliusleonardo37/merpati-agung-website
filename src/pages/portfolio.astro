---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { portfolioItems } from '../data/portfolio';
---

<Layout
  title="Katalog Produk Plastik | Merpati Agung Plastik"
  description="Lihat kategori produk plastik Merpati Agung Plastik: botol HDPE, jerigen plastik, botol pupuk, botol oli, botol HCL, dan supply grosir."
  canonicalPath="/portfolio"
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
        Katalog Produk
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Kategori produk plastik yang dapat kami supply untuk kebutuhan usaha.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Merpati Agung Plastik melayani toko bahan kimia, toko plastik, pabrik pupuk,
        penjual HCL, distributor, dan industri yang membutuhkan produk plastik secara rutin.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {portfolioItems.map((item) => (
            <article class="overflow-hidden rounded-3xl border border-stone-200 bg-stone-50">
              {item.image ? (
                <img
                  src={item.image}
                  alt={`${item.title} - ${item.category} dari Merpati Agung Plastik`}
                  class="h-64 w-full object-cover"
                />
              ) : (
                <div class="flex h-64 items-center justify-center bg-gradient-to-br from-emerald-50 to-stone-200">
                  <span class="text-sm font-semibold uppercase tracking-[0.25em] text-stone-500">
                    Produk Plastik
                  </span>
                </div>
              )}

              <div class="p-6">
                <p class="text-sm font-semibold text-emerald-700">
                  {item.category} - {item.location}
                </p>

                <h2 class="mt-3 text-2xl font-bold">
                  {item.title}
                </h2>

                <p class="mt-4 leading-7 text-stone-600">
                  {item.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-3xl border border-stone-200 bg-white p-8 md:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
            Catatan Produk
          </p>

          <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
            Pilihan produk plastik disesuaikan dengan kebutuhan penggunaan.
          </h2>

          <p class="mt-5 max-w-3xl leading-8 text-stone-600">
            Untuk HCL, bahan kimia, pupuk cair, oli, dan produk teknis lain, spesifikasi
            kemasan perlu dikonfirmasi lebih dulu. Tim kami akan membantu mengecek pilihan
            produk yang paling sesuai dengan kebutuhan order.
          </p>
        </div>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>
