---
import '../styles/global.css';
import { site } from '../data/site';

const {
  title = site.seo.title,
  description = site.seo.description,
  canonicalPath = '/',
} = Astro.props;

const normalizedCanonicalPath =
  canonicalPath === '/' ? '/' : `/${canonicalPath.replace(/^\/+|\/+$/g, '')}`;

const baseUrl = site.url.replace(/\/+$/g, '');
const canonicalUrl = `${baseUrl}${normalizedCanonicalPath === '/' ? '/' : normalizedCanonicalPath}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="keywords" content={site.seo.keywords.join(', ')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site.name,
      description: site.seo.description,
      url: site.url,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Sidoarjo',
        addressRegion: 'Jawa Timur',
        addressCountry: 'ID'
      },
      areaServed: site.areas,
      makesOffer: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Product',
            name: 'Produk Plastik Industri',
            description: 'Botol plastik HDPE, jerigen plastik, botol pupuk, botol kemasan oli, botol HCL, dan kemasan plastik untuk bahan kimia tertentu.'
          }
        }
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: `+${site.whatsappNumber}`,
        availableLanguage: ['Indonesian']
      }
    })} />
  </head>

  <body class="bg-stone-50 antialiased">
    <slot />
  </body>
</html>
