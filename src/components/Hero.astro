---
import { whatsappUrl } from '../data/site';
---

<section class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 pb-20 pt-32">
  <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
    Merpati Agung Plastik
  </p>

  <h1 class="max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
    Pabrik dan Supplier Produk Plastik untuk Kebutuhan Usaha Anda
  </h1>

  <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
    Merpati Agung Plastik menyediakan botol plastik HDPE, jerigen plastik,
    botol pupuk, botol kemasan oli, botol HCL, dan kemasan plastik untuk
    toko bahan kimia, toko plastik, pabrik pupuk, distributor, dan industri.
  </p>

  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full bg-emerald-800 px-6 py-3 text-center text-sm font-semibold text-white transition hover:bg-emerald-900"
    >
      Konsultasi via WhatsApp
    </a>

    <a
      href="#produk"
      class="rounded-full border border-stone-300 px-6 py-3 text-center text-sm font-semibold text-stone-800 transition hover:bg-white"
    >
      Lihat Produk
    </a>
  </div>
</section>
