---
import { systemValues } from '../data/system';
---

<section id="proses-order" class="bg-stone-50 px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
      Proses Order
    </p>

    <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
      Pemesanan produk plastik dibuat jelas sejak awal.
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {systemValues.map((item) => (
        <div class="rounded-3xl border border-stone-200 bg-white p-6">
          <h3 class="text-xl font-semibold">{item.title}</h3>
          <p class="mt-3 text-stone-600">
            {item.description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-3xl bg-emerald-950 p-8 text-white md:p-10">
      <h3 class="text-2xl font-bold">
        Spesifikasi yang tepat membantu proses order lebih rapi.
      </h3>
      <p class="mt-4 max-w-3xl leading-8 text-emerald-50/80">
        Merpati Agung Plastik membantu toko bahan kimia, toko plastik, pabrik pupuk,
        penjual HCL, distributor, dan industri mendapatkan produk plastik sesuai kebutuhan.
        Mulai dari jenis produk, ukuran, tutup, sampai jumlah order dapat dikonsultasikan
        sebelum pemesanan.
      </p>
    </div>
  </div>
</section>
