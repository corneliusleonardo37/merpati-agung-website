---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { portfolioItems } from '../data/portfolio';
---

<Layout
  title="Katalog Botol Plastik HDPE | Merpati Agung Plastik"
  description="Lihat contoh kategori botol plastik HDPE untuk cleaning product, personal care, chemical tertentu, pupuk cair, custom warna, dan kebutuhan supply grosir."
  canonicalPath="/portfolio"
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
        Katalog Produk
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Contoh kebutuhan botol plastik HDPE yang dapat kami bantu produksi.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Merpati Agung Plastik melayani kebutuhan botol HDPE untuk cleaning product,
        personal care, chemical tertentu, pupuk cair, produk industri, dan kebutuhan
        supply botol plastik partai besar.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {portfolioItems.map((item) => (
            <article class="overflow-hidden rounded-3xl border border-stone-200 bg-stone-50">
              {item.image ? (
                <img
                  src={item.image}
                  alt={`${item.title} - ${item.category} dari Merpati Agung Plastik`}
                  class="h-64 w-full object-cover"
                />
              ) : (
                <div class="flex h-64 items-center justify-center bg-gradient-to-br from-emerald-50 to-stone-200">
                  <span class="text-sm font-semibold uppercase tracking-[0.25em] text-stone-500">
                    Botol HDPE
                  </span>
                </div>
              )}

              <div class="p-6">
                <p class="text-sm font-semibold text-emerald-700">
                  {item.category} · {item.location}
                </p>

                <h2 class="mt-3 text-2xl font-bold">
                  {item.title}
                </h2>

                <p class="mt-4 leading-7 text-stone-600">
                  {item.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="rounded-3xl border border-stone-200 bg-white p-8 md:p-12">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
            Catatan Produk
          </p>

          <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
            Spesifikasi botol dapat disesuaikan dengan kebutuhan order.
          </h2>

          <p class="mt-5 max-w-3xl leading-8 text-stone-600">
            Pilihan ukuran, warna, bentuk botol, dan jenis tutup dapat didiskusikan
            berdasarkan ketersediaan model, kebutuhan produk, dan jumlah produksi.
            Untuk kebutuhan custom tertentu, tim kami akan membantu mengecek kemungkinan
            teknisnya terlebih dahulu.
          </p>
        </div>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>