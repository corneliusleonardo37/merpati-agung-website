---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTASection from '../components/CTASection.astro';
import { services } from '../data/services';
---

<Layout
  title="Produk Plastik | Merpati Agung Plastik"
  description="Merpati Agung Plastik menyediakan botol plastik HDPE, jerigen plastik, botol pupuk, botol kemasan oli, botol HCL, dan kemasan plastik untuk bahan kimia."
  canonicalPath="/layanan"
>
  <main class="min-h-screen bg-stone-50 text-stone-900">
    <Header />

    <section class="mx-auto max-w-6xl px-6 pb-20 pt-32">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
        Produk & Layanan
      </p>

      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        Produk plastik untuk toko bahan kimia, toko plastik, pabrik, dan industri.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
        Kami melayani kebutuhan botol HDPE, jerigen, botol pupuk, botol oli,
        botol HCL, dan kemasan plastik lain untuk pemesanan grosir maupun B2B.
      </p>
    </section>

    <section class="bg-white px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-6 md:grid-cols-2">
          {services.map((service) => (
            <div class="rounded-3xl border border-stone-200 bg-stone-50 p-8">
              <h2 class="text-2xl font-bold">{service.title}</h2>
              <p class="mt-4 leading-8 text-stone-600">
                {service.description}
              </p>

              <div class="mt-6 rounded-2xl bg-white p-5 text-sm leading-7 text-stone-600">
                Spesifikasi dapat didiskusikan berdasarkan jenis produk, kapasitas,
                bahan, warna, tutup, jumlah pemesanan, dan kebutuhan pengiriman.
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-stone-50 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">
          Catatan Produk
        </p>

        <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight md:text-4xl">
          Spesifikasi kemasan perlu dikonfirmasi sebelum pemesanan.
        </h2>

        <p class="mt-5 max-w-3xl leading-8 text-stone-600">
          Jenis cairan, ukuran, model botol atau jerigen, jenis tutup, dan jumlah order
          akan memengaruhi pilihan produk plastik. Konsultasi awal membantu kami memberi
          arahan yang lebih tepat dan realistis.
        </p>
      </div>
    </section>

    <CTASection />

    <Footer />

    <WhatsAppButton />
  </main>
</Layout>
